# Sahayog Care backend environment variables (example).
# Copy to `.env` and fill in real values. Never commit the real `.env`.

APP_NAME="Sahayog Care"
ENVIRONMENT=development
# Progress logs (booking/consultation steps) print at this level; DEBUG, INFO,
# WARNING, ERROR. INFO shows per-step progress in the terminal and in
# deployment stdout logs.
LOG_LEVEL=INFO

# Comma-separated list is parsed by pydantic-settings as JSON; keep as a JSON array.
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Supabase (Postgres) ---
# Used by later phases for appointments/patients. The symptom catalogue is NOT
# stored here; it is managed in app/book_appointment/data/symptoms.json.
# Project URL and keys from the Supabase dashboard (Settings -> API).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key is used server-side only for admin writes. Never expose to the frontend.
SUPABASE_SERVICE_KEY=
DB_PASSWORD=

# --- OpenRouter (chat model used for consultation SOAP drafts) ---
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model id routed through OpenRouter. Swappable per PRD section 7 (one adapter, swappable vendor).
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Seconds before a model call times out (PRD: every model call has a timeout).
OPENROUTER_TIMEOUT_SECONDS=30

# --- Jev decisions classifier (symptom triage) ---
# Jev is a "System One" decision model: it returns per-category probabilities
# (weightage), not text. Uses the same OPENROUTER_API_KEY above.
# Docs: https://openrouter.ai/docs/guides/community/jev
SYMPTOM_CLASSIFIER_MODEL=typesafe/jev-1.13
OPEN_ROUTER_CLASSIFIER_URL=https://openrouter.ai/api/alpha/decisions

# --- LangSmith tracing (observability / audit) ---
# Traces the booking LangGraph flow; each node appears as a span.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=sahayog-care
LANGSMITH_AGENT_ENVIRONMENT=local

# --- Object storage (Phase 2.1: signatures + transcripts) ---
# When these are set, files go to S3 (keep the bucket private, region in India
# per the PRD). When unset, files are stored locally under backend/storage/.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET=
S3_PREFIX=dev/

# --- Sarvam speech-to-text with automatic speaker separation ---
# Server-side only. Never put this key in VITE_* variables.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TIMEOUT_SECONDS=60
SARVAM_MAX_AUDIO_BYTES=104857600
SHOW_SPEECH_TRANSCRIPTS=false

# --- Phase 5: consultation memory ---
# Optional. A direct Postgres connection string (Supabase dashboard -> Connect
# -> "Session pooler" URI) used only by the SOAP graph's LangGraph checkpointer,
# so a crashed/restarted worker can resume a SOAP job instead of restarting it
# cold. Leave blank to run without checkpointing (current behavior).
CONSULTATION_CHECKPOINT_DB_URL=
# Days of processing state (consultation_jobs rows, transcript/SOAP edit
# drafts) kept before scripts/cleanup_consultation_processing.py may purge it.
# Signed records, signatures and recorded audio have no TTL and are never
# touched by that script.
CONSULTATION_PROCESSING_TTL_DAYS=15

# --- Phase 6.1: search ingestion for the future patient chatbot ---
# All optional; the ingestion worker and the booking/consultation enqueue
# hooks are no-ops until every one of these is set. See
# docs/Progress/Phase6.md for the AWS OpenSearch setup steps.
# Embedding model id routed through OpenRouter (same OPENROUTER_API_KEY above).
# Avoid free-tier models here -- they rate-limit almost immediately under
# any real load. openai/text-embedding-3-small is cheap ($0.02/1M tokens)
# and reliable.
OPENROUTER_EMBEDDINGS_MODEL=openai/text-embedding-3-small
# Must match the embedding model's output dimension and the OpenSearch
# index's knn_vector mapping (scripts/create_search_index.py reads this).
# text-embedding-3-small's native output is 1536.
EMBEDDING_DIM=1536
# OpenSearch domain endpoint, no trailing slash, e.g.
# https://search-xxxxx.ap-south-1.es.amazonaws.com
OPENSEARCH_ENDPOINT=
OPENSEARCH_INDEX=sahayog-care-chunks
# Optional. Leave blank to reuse AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# above (S3) -- just grant that IAM user es:ESHttpGet/Put/Post/Delete on the
# OpenSearch domain's ARN too. Set these only if you'd rather use a separate,
# narrowly-scoped IAM user for OpenSearch (keeps a leaked credential for one
# service from reaching the other).
OPENSEARCH_AWS_ACCESS_KEY_ID=
OPENSEARCH_AWS_SECRET_ACCESS_KEY=
